# ─────────────────────────────────────────────────────────────
# Boîte à outils — variables d'environnement
# Copier en .env (local) ou renseigner dans Coolify (déploiement).
# ─────────────────────────────────────────────────────────────

# Connexion PostgreSQL (Prisma)
# En local avec le docker-compose fourni :
DATABASE_URL="postgresql://boite:boite@localhost:5432/boite_outils?schema=public"

# Compte admin initial, créé par le seed (prisma db seed).
# À ne renseigner que pour l'amorçage ; peut être retiré ensuite.
ADMIN_EMAIL="contact@dekolak.fr"
ADMIN_PASSWORD="change-moi"

# URL publique de la plateforme (sert à construire le snippet d'embed).
# OPTIONNELLE : si absente, l'URL est déduite de l'hôte de la requête.
# Variable runtime classique (PAS NEXT_PUBLIC_*, qui serait figée au build).
# Ex. https://outils.dekolak.fr — sans slash final.
APP_URL="http://localhost:3000"
